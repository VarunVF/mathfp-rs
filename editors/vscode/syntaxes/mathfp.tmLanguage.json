{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "MathFP",
	"scopeName": "source.mfp",
	"fileTypes": [
		".mfp"
	],
	"foldingStartMarker": "\\{\\s*$",
	"foldingStopMarker": "^\\s*\\}",
	"patterns": [
		{
			"name": "comment.block.documentation.mfp",
			"match": "///.*$"
		},
		{
			"name": "comment.line.double-slash.mfp",
			"match": "//.*$"
		},
		{
			"name": "string.quoted.double.mfp",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.mfp",
					"match": "\\\\."
				}
			]
		},
		{
			"name": "constant.numeric.mfp",
			"match": "\\b\\d+(\\.\\d+)?\\b"
		},
		{
			"name": "keyword.control.mfp",
			"match": "\\b(if|then|else|match)\\b"
		},
		{
			"name": "constant.language.boolean.mfp",
			"match": "\\b(true|false)\\b"
		},
		{
			"name": "constant.language.nil.mfp",
			"match": "\\b(nil)\\b"
		},
		{
			"name": "support.function.builtin.mfp",
			"match": "\\b(__\\w*)\\b"
		},
		{
			"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\()",
			"captures": {
				"1": {
					"name": "entity.name.function.mfp"
				}
			}
		},
		{
			"match": "([A-Za-z_][A-Za-z0-9_]*)\\s*\\|->",
			"captures": {
				"1": {
					"name": "variable.parameter.mfp"
				}
			}
		},
		{
			"name": "keyword.operator.mfp",
			"match": ":=|\\|->|=>|==|!=|<=|>=|[+\\-*/<>]"
		},
		{
			"name": "variable.other.mfp",
			"match": "[A-Za-z_][A-Za-z0-9_]*"
		}
	]
}