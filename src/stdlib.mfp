// I/O
args    := _ |-> __args;
print   := x |-> __print(x);
println := x |-> __println(x);

// Math
sin  := x |-> __sin(x);
cos  := x |-> __cos(x);
sqrt := x |-> __sqrt(x);

// Timing
clock := _ |-> __clock(_);
time  := f |-> x |-> {
    t1 := __clock(nil);
    f(x);
    t2 := __clock(nil);
    t2 - t1
};

// Types
type := x |-> __type(x);
bool := x |-> __bool(x);
str  := x |-> __str(x);

// List processing
map    := f |-> list |-> __map([f, list]);
filter := f |-> list |-> __filter([f, list]);
foldl  := f |-> init |-> list |-> __foldl([f, init, list]);
foldr  := f |-> init |-> list |-> __foldr([f, init, list]);
reduce := foldl;

// String, list methods
len := list |-> __len(list);
get := list |-> i |-> __get([list, i]);
