// I/O
args    := _ |-> __args;
print   := x |-> __print(x);
println := x |-> __println(x);
read_file  := filename |-> __read_file(filename);
write_file := filename |-> text |-> __write_file([filename, text]);

// Math
sin   := x |-> __sin(x);
cos   := x |-> __cos(x);
sqrt  := x |-> __sqrt(x);
floor := x |-> __floor(x);
ceil  := x |-> __ceil(x);

// Timing
clock := __clock;
time  := f |-> x |-> {
    t1 := __clock();
    f(x);
    t2 := __clock();
    t2 - t1
};

// Types
type := x |-> __type(x);
bool := x |-> __bool(x);
str  := x |-> __str(x);

// List processing
map    := f |-> list |-> __map([f, list]);
filter := f |-> list |-> __filter([f, list]);
foldl  := f |-> init |-> list |-> __foldl([f, init, list]);
foldr  := f |-> init |-> list |-> __foldr([f, init, list]);
reduce := foldl;

// String, list methods
len := iterable |-> __len(iterable);
get := iterable |-> i |-> __get([iterable, i]);
slice := iterable |-> start |-> stop |-> __slice([iterable, start, stop]);
split := str |-> sep |-> __split([str, sep]);
join := str_list |-> sep |-> __join([str_list, sep]);
