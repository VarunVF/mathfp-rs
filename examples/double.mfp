double := x |-> x * 2;

pow2 := x |-> {
    if x == 0 then
        1
    else
        2 * pow2(x - 1)
};

grow_list := items |-> n |-> curr |-> {
    if n == curr then {
        items
    }
    else {
        x := pow2(curr);
        grow_list(items + x * [x], n, curr + 1);
    }
};

println(grow_list([], 4, 0));
